#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
source "${SCRIPT_DIR}/scripts/common"

usage() {
    cat <<'USAGE'
Usage: ./build [options]

Options:
  -c, --configuration <Debug|Release>  Build configuration. Default: Debug.
      --no-restore                     Skip dotnet restore.
  -h, --help                           Show this help text.
USAGE
}

configuration="Debug"
no_restore=0

while (($#)); do
    case "$1" in
        -c|--configuration)
            shift
            cli_require_value "--configuration" "${1-}"
            configuration="$1"
            ;;
        --no-restore)
            no_restore=1
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            cli_die "unknown option '$1'"
            ;;
    esac
    shift
done

cli_validate_configuration "$configuration"

cd "$CLI_REPO_ROOT"
cli_prepare_nuget_config
trap cli_restore_nuget_config EXIT

if [[ "$no_restore" -eq 0 ]]; then
    dotnet restore "$CLI_SOLUTION" -v minimal -m:1
fi

dotnet build "$CLI_SOLUTION" -v minimal -c "$configuration" --no-restore -m:1
